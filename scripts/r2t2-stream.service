[Unit]
Description=EtherealFlow R2T2 streaming ASR service (WebSocket)
Documentation=https://github.com/
After=network.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
# 用 `bash <脚本>` 而不是直接执行脚本：
# 仓库里 .sh 的 mode 是 100644（Windows 上没有 Unix 权限位），
# 直接 ExecStart 会报 203/EXEC（实测踩过）。交给 bash 解释就不依赖执行位。
ExecStart=/bin/bash @APP_DIR@/start_stream_server.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# 模型常驻显存约 2.5 GB；显存不足时会被 OOM 杀掉，Restart 会重试
TimeoutStopSec=20
KillSignal=SIGTERM

[Install]
WantedBy=default.target
